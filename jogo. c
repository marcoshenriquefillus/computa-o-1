#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define TAM 5

void inicializarTabuleiro()
{
    for(int i=0;i<TAM;i++)
    {
        for(int j=0;j<TAM;j++)
        {
            tab[i][j]='.';
        }
    }
}

void mostrarTabuleiro()
{
    printf("\n");

    for(int i=0;i<TAM;i++)
    {
        for(int j=0;j<TAM;j++)
        {
            printf("%c ",tab[i][j]);
        }
        printf("\n");
    }

    printf("\n");
}

int posicaoValida(int l,int c)
{
    if(l<0 || l>=TAM || c<0 || c>=TAM)
        return 0;

    if(tab[l][c] != '.')
        return 0;

    if(congeladaTurnos>0 &&
       l==congeladaLinha &&
       c==congeladaColuna)
        return 0;

    return 1;
}

void congelarCasas()
{
    congeladaLinha = 1;
    congeladaColuna = 2;
    congeladaTurnos = 1;
}
